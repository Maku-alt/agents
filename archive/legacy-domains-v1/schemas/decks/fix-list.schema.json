{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deck Fix List",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "severity",
      "area",
      "issue",
      "why_it_matters",
      "recommended_fix",
      "owner_agent",
      "status"
    ],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "severity": {
        "type": "string",
        "enum": ["blocker", "major", "minor", "polish"]
      },
      "area": {
        "type": "string",
        "enum": ["orchestration", "narrative", "design", "review", "build"]
      },
      "issue": { "type": "string", "minLength": 1 },
      "why_it_matters": { "type": "string", "minLength": 1 },
      "recommended_fix": { "type": "string", "minLength": 1 },
      "owner_agent": {
        "type": "string",
        "enum": ["orchestrator", "narrative", "design", "review", "ppt-builder"]
      },
      "status": {
        "type": "string",
        "enum": ["open", "accepted", "resolved", "deferred"]
      }
    },
    "additionalProperties": true
  }
}
